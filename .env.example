# Frontend (browser) variables. Everything prefixed VITE_ is bundled into the PUBLIC website.
# Never put secrets here. Copy to .env.local for local development.

# Supabase project URL (the quote form posts to its submit-quote function). The anon key is not used by
# the quote form (verify_jwt = false) and is kept only for future use. Local values: `npm run supabase -- status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Cloudflare Turnstile site key (public). Cloudflare's always-pass test key for local dev:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
