# Frontend (browser) variables. Everything prefixed VITE_ is bundled into the PUBLIC website.
# Never put secrets here. Copy to .env.local for local development.

# Supabase project URL and public (anon/publishable) key. Local values are printed by `npm run supabase -- start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Cloudflare Turnstile site key (public). Cloudflare's always-pass test key for local dev:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
