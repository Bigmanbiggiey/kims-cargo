# Server-only secrets for Supabase Edge Functions. NEVER prefix with VITE_ and never commit real values.
# Local: copy to supabase/functions/.env. Production: `npx supabase secrets set --env-file <file>`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically by Supabase.

# Websites allowed to call submit-quote (comma-separated, exact origins, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where quote notifications go.
ENQUIRY_RECIPIENT_EMAIL=kimsandcargos1@gmail.com

# Gmail SMTP (port 465, TLS). Requires 2-Step Verification + an App Password on the sending account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GMAIL_SMTP_USER=kimsandcargos1@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-gmail-app-password

# Local testing without Gmail: send to the local Supabase test inbox (http://127.0.0.1:54324) instead.
# SMTP_HOST=supabase_inbucket_kims-cargo
# SMTP_PORT=1025
# SMTP_SECURE=false
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=

# Cloudflare Turnstile secret. Cloudflare's always-pass test secret for local dev:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random string used to hash visitor IPs for rate limiting (generate a long random value).
IP_HASH_SALT=replace-with-long-random-string
